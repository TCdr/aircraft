<ModelBehaviors>
    <Template Name="FBW_A380X_Components_Glareshield">
        <!-- CAPT side -->

        <!-- ATC MSG -->
        <UseTemplate Name="FBW_Push_Toggle">
            <NODE_ID>PUSH_GLARESHIELD_CS_ATCMSG</NODE_ID>
            <TOOLTIPID>ACKNOWLEDGE ATC MSG</TOOLTIPID>
            <LEFT_SINGLE_CODE>1 (&gt;L:A32NX_DCDU_ATC_MSG_ACK)</LEFT_SINGLE_CODE>
            <!-- FIXME korry should be split in two, and each half connected to correct CPIOM + power supply  -->
            <!-- Flashing at 2 Hz from the systems host (Misc/AtcMsgLights.ts), A380 FCOM DSC-46-10-20-70 -->
            <SEQ1_CODE>(L:A380X_GLARESHIELD_ATC_MSG_LIGHT)</SEQ1_CODE>
            <SEQ1_POWERED>(L:A32NX_ELEC_DC_ESS_BUS_IS_POWERED) (L:A32NX_ELEC_DC_2_BUS_IS_POWERED) or</SEQ1_POWERED>
            <DISABLE_SEQ2/>
        </UseTemplate>

        <!-- AUTO LAND -->
        <!-- Lit and flashing from the systems host (Misc/AutolandLights.ts): the lamp code cannot read the sim time -->
        <!-- A380 FCOM DSC-22-FG-80-100: the light flashes in autoland below 200 ft RA when the autoland conditions are lost,
             and "as long as the AUTOLAND light is pressed, the AUTOLAND light flashes" (light test) -->
        <UseTemplate Name="FBW_Push_Held">
            <NODE_ID>PUSH_GLARESHIELD_CS_AUTOLAND</NODE_ID>
            <TOOLTIPID>AUTOLAND (PRESS TO TEST)</TOOLTIPID>
            <HOLD_SIMVAR>L:A380X_GLARESHIELD_AUTOLAND_TEST_L</HOLD_SIMVAR>
            <!-- FIXME korry should be split in two, and each half connected to correct CPIOM + power supply  -->
            <SEQ1_CODE>(L:A380X_GLARESHIELD_AUTOLAND_LIGHT_L, bool)</SEQ1_CODE>
            <SEQ1_POWERED>(L:A32NX_ELEC_DC_ESS_BUS_IS_POWERED) (L:A32NX_ELEC_DC_2_BUS_IS_POWERED) or</SEQ1_POWERED>
            <DISABLE_SEQ2/>
            <WWISE_EVENT_1>pb1on</WWISE_EVENT_1>
            <WWISE_EVENT_2>pb1off</WWISE_EVENT_2>
        </UseTemplate>

        <!-- MASTER WARN -->
        <UseTemplate Name="FBW_Push_Held">
            <NODE_ID>PUSH_GLARESHIELD_CS_MASTERWARN</NODE_ID>
            <TOOLTIPID>ACKNOWLEDGE MASTER WARNING</TOOLTIPID>
            <HOLD_SIMVAR>L:PUSH_AUTOPILOT_MASTERAWARN_L</HOLD_SIMVAR>
            <!-- FIXME korry should be split in two, and each half connected to correct CPIOM + power supply  -->
            <SEQ1_CODE>(L:A32NX_MASTER_WARNING)</SEQ1_CODE>
            <SEQ1_POWERED>(L:A32NX_ELEC_DC_ESS_BUS_IS_POWERED) (L:A32NX_ELEC_DC_2_BUS_IS_POWERED) or</SEQ1_POWERED>
            <DISABLE_SEQ2/>
            <WWISE_EVENT_1>pb1on</WWISE_EVENT_1>
            <WWISE_EVENT_2>pb1off</WWISE_EVENT_2>
        </UseTemplate>

        <!-- MASTER CAUT -->
        <UseTemplate Name="FBW_Push_Held">
            <NODE_ID>PUSH_GLARESHIELD_CS_MASTERCAUT</NODE_ID>
            <TOOLTIPID>ACKNOWLEDGE MASTER CAUTION</TOOLTIPID>
            <HOLD_SIMVAR>L:PUSH_AUTOPILOT_MASTERCAUT_L</HOLD_SIMVAR>
            <!-- FIXME korry should be split in two, and each half connected to correct CPIOM + power supply  -->
            <SEQ1_CODE>(L:A32NX_MASTER_CAUTION)</SEQ1_CODE>
            <SEQ1_POWERED>(L:A32NX_ELEC_DC_ESS_BUS_IS_POWERED) (L:A32NX_ELEC_DC_2_BUS_IS_POWERED) or</SEQ1_POWERED>
            <DISABLE_SEQ2/>
            <WWISE_EVENT_1>pb1on</WWISE_EVENT_1>
            <WWISE_EVENT_2>pb1off</WWISE_EVENT_2>
        </UseTemplate>

        <!-- SIDESTICK PROPRITY -->
        <UseTemplate Name="FBW_Push_Toggle">
            <NODE_ID>PUSH_GLARESHIELD_CS_SIDESTICK</NODE_ID>
            <TOOLTIPID>SIDESTICK PRIORITY (INOP.)</TOOLTIPID>
            <!-- FIXME korry should be split in two, and each half connected to correct CPIOM + power supply  -->
        </UseTemplate>

        <!-- OIT SIDE SWITCH -->
        <UseTemplate Name="A32NX_GT_Switch_Dummy">
            <NODE_ID>SWITCH_GLARESHIELD_CS_OIT_SIDE</NODE_ID>
            <PART_ID>SWITCH_GLARESHIELD_CS_OIT_SIDE</PART_ID>
            <ANIM_NAME>SWITCH_GLARESHIELD_CS_OIT_SIDE</ANIM_NAME>
            <NUM_STATES>2</NUM_STATES>
            <SWITCH_DIRECTION>Vertical</SWITCH_DIRECTION>
            <SWITCH_POSITION_TYPE>L</SWITCH_POSITION_TYPE>
            <SWITCH_POSITION_VAR>A380X_SWITCH_OIT_SIDE_LEFT</SWITCH_POSITION_VAR>
            <ANIMTIP_0>TT:A380X.TOOLTIPS.OIT_SIDE_NSS_AVNCS</ANIMTIP_0>
            <ANIMTIP_1>TT:A380X.TOOLTIPS.OIT_SIDE_NSS_FLTOPS</ANIMTIP_1>
            <WWISE_EVENT_1>lswitch</WWISE_EVENT_1>
            <WWISE_EVENT_2>lswitch</WWISE_EVENT_2>
            <NORMALIZED_TIME_1>0.1</NORMALIZED_TIME_1>
            <NORMALIZED_TIME_2>0.5</NORMALIZED_TIME_2>
            <CODE_POS_0></CODE_POS_0>
            <CODE_POS_1></CODE_POS_1>
            <INVERT_ANIM>1</INVERT_ANIM>
        </UseTemplate>

        <!-- FO side -->

        <!-- ATC MSG -->
        <UseTemplate Name="FBW_Push_Toggle">
            <NODE_ID>PUSH_GLARESHIELD_FO_ATCMSG</NODE_ID>
            <TOOLTIPID>ACKNOWLEDGE ATC MSG</TOOLTIPID>
            <LEFT_SINGLE_CODE>1 (&gt;L:A32NX_DCDU_ATC_MSG_ACK)</LEFT_SINGLE_CODE>
            <!-- FIXME korry should be split in two, and each half connected to correct CPIOM + power supply  -->
            <!-- Flashing at 2 Hz from the systems host (Misc/AtcMsgLights.ts), A380 FCOM DSC-46-10-20-70 -->
            <SEQ1_CODE>(L:A380X_GLARESHIELD_ATC_MSG_LIGHT)</SEQ1_CODE>
            <SEQ1_POWERED>(L:A32NX_ELEC_DC_ESS_BUS_IS_POWERED) (L:A32NX_ELEC_DC_2_BUS_IS_POWERED) or</SEQ1_POWERED>
            <DISABLE_SEQ2/>
        </UseTemplate>

        <!-- AUTO LAND -->
        <!-- Lit and flashing from the systems host (Misc/AutolandLights.ts): the lamp code cannot read the sim time -->
        <!-- A380 FCOM DSC-22-FG-80-100: the light flashes in autoland below 200 ft RA when the autoland conditions are lost,
             and "as long as the AUTOLAND light is pressed, the AUTOLAND light flashes" (light test) -->
        <UseTemplate Name="FBW_Push_Held">
            <NODE_ID>PUSH_GLARESHIELD_FO_AUTOLAND</NODE_ID>
            <TOOLTIPID>AUTOLAND (PRESS TO TEST)</TOOLTIPID>
            <HOLD_SIMVAR>L:A380X_GLARESHIELD_AUTOLAND_TEST_R</HOLD_SIMVAR>
            <!-- FIXME korry should be split in two, and each half connected to correct CPIOM + power supply  -->
            <SEQ1_CODE>(L:A380X_GLARESHIELD_AUTOLAND_LIGHT_R, bool)</SEQ1_CODE>
            <SEQ1_POWERED>(L:A32NX_ELEC_DC_ESS_BUS_IS_POWERED) (L:A32NX_ELEC_DC_2_BUS_IS_POWERED) or</SEQ1_POWERED>
            <DISABLE_SEQ2/>
            <WWISE_EVENT_1>pb1on</WWISE_EVENT_1>
            <WWISE_EVENT_2>pb1off</WWISE_EVENT_2>
        </UseTemplate>

        <!-- MASTER WARN -->
        <UseTemplate Name="FBW_Push_Held">
            <NODE_ID>PUSH_GLARESHIELD_FO_MASTERWARN</NODE_ID>
            <TOOLTIPID>ACKNOWLEDGE MASTER WARNING</TOOLTIPID>
            <HOLD_SIMVAR>L:PUSH_AUTOPILOT_MASTERAWARN_R</HOLD_SIMVAR>
            <!-- FIXME korry should be split in two, and each half connected to correct CPIOM + power supply  -->
            <SEQ1_CODE>(L:A32NX_MASTER_WARNING)</SEQ1_CODE>
            <SEQ1_POWERED>(L:A32NX_ELEC_DC_ESS_BUS_IS_POWERED) (L:A32NX_ELEC_DC_2_BUS_IS_POWERED) or</SEQ1_POWERED>
            <DISABLE_SEQ2/>
            <WWISE_EVENT_1>pb1on</WWISE_EVENT_1>
            <WWISE_EVENT_2>pb1off</WWISE_EVENT_2>
        </UseTemplate>

        <!-- MASTER CAUT -->
        <UseTemplate Name="FBW_Push_Held">
            <NODE_ID>PUSH_GLARESHIELD_FO_MASTERCAUT</NODE_ID>
            <TOOLTIPID>ACKNOWLEDGE MASTER CAUTION</TOOLTIPID>
            <HOLD_SIMVAR>L:PUSH_AUTOPILOT_MASTERCAUT_R</HOLD_SIMVAR>
            <!-- FIXME korry should be split in two, and each half connected to correct CPIOM + power supply  -->
            <SEQ1_CODE>(L:A32NX_MASTER_CAUTION)</SEQ1_CODE>
            <SEQ1_POWERED>(L:A32NX_ELEC_DC_ESS_BUS_IS_POWERED) (L:A32NX_ELEC_DC_2_BUS_IS_POWERED) or</SEQ1_POWERED>
            <DISABLE_SEQ2/>
            <WWISE_EVENT_1>pb1on</WWISE_EVENT_1>
            <WWISE_EVENT_2>pb1off</WWISE_EVENT_2>
        </UseTemplate>

        <!-- SIDESTICK PROPRITY -->
        <UseTemplate Name="FBW_Push_Toggle">
            <NODE_ID>PUSH_GLARESHIELD_FO_SIDESTICK</NODE_ID>
            <TOOLTIPID>SIDESTICK PRIORITY (INOP.)</TOOLTIPID>
            <!-- FIXME korry should be split in two, and each half connected to correct CPIOM + power supply  -->
        </UseTemplate>

        <!-- OIT SIDE SWITCH -->
        <UseTemplate Name="A32NX_GT_Switch_Dummy">
            <NODE_ID>SWITCH_GLARESHIELD_FO_OIT_SIDE</NODE_ID>
            <PART_ID>SWITCH_GLARESHIELD_FO_OIT_SIDE</PART_ID>
            <ANIM_NAME>SWITCH_GLARESHIELD_FO_OIT_SIDE</ANIM_NAME>
            <NUM_STATES>2</NUM_STATES>
            <SWITCH_DIRECTION>Vertical</SWITCH_DIRECTION>
            <SWITCH_POSITION_TYPE>L</SWITCH_POSITION_TYPE>
            <SWITCH_POSITION_VAR>A380X_SWITCH_OIT_SIDE_RIGHT</SWITCH_POSITION_VAR>
            <ANIMTIP_0>TT:A380X.TOOLTIPS.OIT_SIDE_NSS_AVNCS</ANIMTIP_0>
            <ANIMTIP_1>TT:A380X.TOOLTIPS.OIT_SIDE_NSS_FLTOPS</ANIMTIP_1>
            <WWISE_EVENT_1>lswitch</WWISE_EVENT_1>
            <WWISE_EVENT_2>lswitch</WWISE_EVENT_2>
            <NORMALIZED_TIME_1>0.1</NORMALIZED_TIME_1>
            <NORMALIZED_TIME_2>0.5</NORMALIZED_TIME_2>
            <CODE_POS_0></CODE_POS_0>
            <CODE_POS_1></CODE_POS_1>
            <INVERT_ANIM>1</INVERT_ANIM>
        </UseTemplate>

        <!-- CAPT LOUDSPEAKER volume knob: fully anticlockwise = OFF. Scales the COM receive volumes, not the FWS and SURV
             sounds (A380 FCOM DSC-23-20 LOUDSPEAKER VOLUME CONTROL PANEL), see systems-host Misc/Communications/LoudspeakerVolume.ts -->
        <Component ID="KNOB_GLARESHIELD_CS_SPEAKER_VOLUME" Node="KNOB_GLARESHIELD_CS_SPEAKER">
            <UseTemplate Name="FBW_Continuous_Knob_Finite_From_Simvar">
                <NODE_ID>KNOB_GLARESHIELD_CS_SPEAKER</NODE_ID>
                <ANIM_SIMVAR>L:A380X_LOUDSPEAKER_1_VOLUME</ANIM_SIMVAR>
                <INCREMENT>2</INCREMENT>
                <WHEEL_INCREMENT>5</WHEEL_INCREMENT>
                <ANIMTIP_0>CAPT loudspeaker volume: decrease (%((L:A380X_LOUDSPEAKER_1_VOLUME, percent))%!d!%%)</ANIMTIP_0>
                <ANIMTIP_1>CAPT loudspeaker volume: increase (%((L:A380X_LOUDSPEAKER_1_VOLUME, percent))%!d!%%)</ANIMTIP_1>
            </UseTemplate>
        </Component>

        <!-- F/O LOUDSPEAKER volume knob: fully anticlockwise = OFF. Scales the COM receive volumes, not the FWS and SURV
             sounds (A380 FCOM DSC-23-20 LOUDSPEAKER VOLUME CONTROL PANEL), see systems-host Misc/Communications/LoudspeakerVolume.ts -->
        <Component ID="KNOB_GLARESHIELD_FO_SPEAKER_VOLUME" Node="KNOB_GLARESHIELD_FO_SPEAKER">
            <UseTemplate Name="FBW_Continuous_Knob_Finite_From_Simvar">
                <NODE_ID>KNOB_GLARESHIELD_FO_SPEAKER</NODE_ID>
                <ANIM_SIMVAR>L:A380X_LOUDSPEAKER_2_VOLUME</ANIM_SIMVAR>
                <INCREMENT>2</INCREMENT>
                <WHEEL_INCREMENT>5</WHEEL_INCREMENT>
                <ANIMTIP_0>F/O loudspeaker volume: decrease (%((L:A380X_LOUDSPEAKER_2_VOLUME, percent))%!d!%%)</ANIMTIP_0>
                <ANIMTIP_1>F/O loudspeaker volume: increase (%((L:A380X_LOUDSPEAKER_2_VOLUME, percent))%!d!%%)</ANIMTIP_1>
            </UseTemplate>
        </Component>
    </Template>
</ModelBehaviors>
